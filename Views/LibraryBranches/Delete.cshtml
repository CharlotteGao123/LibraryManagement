@model LibraryManagement.Models.LibraryBranch

<h2>Delete Branch</h2>

<!-- 新增：显示服务器端错误 -->
<div asp-validation-summary="All" class="text-danger"></div>

<h4>Are you sure you want to delete this branch?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Address</dt>
    <dd class="col-sm-10">@Model.Address</dd>

    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Phone</dd>

    <dt class="col-sm-2">Books Count</dt>
    <dd class="col-sm-10">@Model.Books?.Count</dd>

    <dt class="col-sm-2">Customers Count</dt>
    <dd class="col-sm-10">@Model.Customers?.Count</dd>
</dl>

@{
    var hasDeps = (Model.Books?.Any() ?? false) || (Model.Customers?.Any() ?? false);
    if (hasDeps)
    {
        <div class="alert alert-warning">
            This branch has @Model.Books?.Count books and @Model.Customers?.Count customers.
            You must reassign/delete related records before deleting the branch.
        </div>
    }
}

<form asp-action="DeleteConfirmed" asp-route-id="@Model.LibraryBranchId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger" @(hasDeps ? "disabled" : "")>Confirm Delete</button>
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>