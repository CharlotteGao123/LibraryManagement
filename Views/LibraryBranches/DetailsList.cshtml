@model IEnumerable<LibraryManagement.Models.LibraryBranch>

<h2>All Library Branches</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Phone</th>
            <th>Books Count</th>
            <th>Customers Count</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var branch in Model)
        {
            <tr>
                <td>@branch.Name</td>
                <td>@branch.Address</td>
                <td>@branch.Phone</td>
                <td>@(branch.Books?.Count ?? 0)</td>
                <td>@(branch.Customers?.Count ?? 0)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@branch.LibraryBranchId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@branch.LibraryBranchId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@branch.LibraryBranchId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Create New Branch</a>