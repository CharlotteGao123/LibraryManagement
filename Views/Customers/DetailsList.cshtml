@model IEnumerable<LibraryManagement.Models.Customer>

<h2>All Customers</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Branch</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.FirstName @c.LastName</td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td>@c.LibraryBranch?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@c.CustomerId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@c.CustomerId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@c.CustomerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Create New Customer</a>