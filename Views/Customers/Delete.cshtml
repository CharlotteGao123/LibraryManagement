@model LibraryManagement.Models.Customer

<h2>Delete Customer</h2>

<h4>Are you sure you want to delete this customer?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Phone</dt>
    <dd class="col-sm-10">@Model.Phone</dd>

    <dt class="col-sm-2">Branch</dt>
    <dd class="col-sm-10">@Model.LibraryBranch?.Name</dd>
</dl>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.CustomerId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>