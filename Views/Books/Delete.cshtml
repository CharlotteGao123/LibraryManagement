@model LibraryManagement.Models.Book

<h2>Delete Book</h2>

<h4>Are you sure you want to delete this book?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">ISBN</dt>
    <dd class="col-sm-10">@Model.ISBN</dd>

    <dt class="col-sm-2">Published Year</dt>
    <dd class="col-sm-10">@Model.PublishedYear</dd>

    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.Price</dd>

    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@Model.Author?.Name</dd>

    <dt class="col-sm-2">Branch</dt>
    <dd class="col-sm-10">@Model.LibraryBranch?.Name</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>